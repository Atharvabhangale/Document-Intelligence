# Copy to .env for local overrides. Never commit .env. No secrets in this file.

# --- AI provider -------------------------------------------------------------------------
# anthropic | ollama | fake   ("fake" = DEVELOPMENT ONLY canned output, no API calls)
AI_PROVIDER=anthropic
# Haiku model reported by the Models API in the development environment.
AI_MODEL=claude-haiku-4-5-20251001
AI_MAX_OUTPUT_TOKENS=16000
AI_TIMEOUT_SECONDS=120
# Haiku 4.5 accepts a sampling temperature. Newer models (Claude Opus 4.7+, Opus 5, ...) reject
# sampling parameters: set AI_TEMPERATURE=none when switching to them.
AI_TEMPERATURE=0
AI_MAX_REPAIR_ATTEMPTS=1

# Anthropic credential: read from ANTHROPIC_API_KEY, or CAD_ANTHROPIC_API_KEY (provided by the
# Claude Code Web environment). Do not put the key in this file.
# ANTHROPIC_API_KEY=

# Ollama (future local deployment)
# AI_PROVIDER=ollama
# AI_MODEL=<local-ollama-model>
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=32768

# --- Windchill ---------------------------------------------------------------------------
# mock = DEVELOPMENT ONLY sample SOPs (not connected to Windchill)
# windchill12 = placeholder, not implemented until WRS APIs for 12.0.2.19 are validated
WINDCHILL_PROVIDER=mock

# --- Limits & storage --------------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_PAGES=300
MAX_DOCUMENT_TOKENS=120000
MAX_QUESTION_CHARS=1000
# DATA_DIR=./.data
