    "Citation": {
      "additionalProperties": false,
      "description": "A source reference produced by the model and checked against the extracted text.\n\n- ``verified``: quote found on the cited page.\n- ``relocated``: quote found, but on a different page (``matched_page``).\n- ``approximate``: close (fuzzy) match on the cited or another page.\n- ``unverified``: quote not found in the document.\n- ``invalid_page``: cited page does not exist and the quote was not found elsewhere.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "matchScore": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Matchscore",
          "type": "number"
        },
        "matchedPage": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matchedpage"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "relocated",
            "approximate",
            "unverified",
            "invalid_page"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "page",
        "quote",
        "status",
        "matchScore"
      ],
      "title": "Citation",
      "type": "object"
    },
